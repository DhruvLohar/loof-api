# --- Server ---
PORT=8000

# Set to "production" on the EC2 host (.env.prod). Gates CookieSecure on the
# session cookie - only api.letsloof.com should require HTTPS-only cookies,
# not local http://127.0.0.1 dev.
APP_ENV=development

# Copy to .env for local dev, or .env.prod on the EC2 host (what deploy.sh
# feeds the container via --env-file).

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=loof

# "require" for managed hosts (Neon, RDS); "disable" for a local container.
DB_SSLMODE=require

# --- Auth ---
# Signs session JWTs. Generate with: openssl rand -hex 32
SECRET_KEY=

# --- Image Storage (S3) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
# Optional: CDN/custom domain to serve uploads from. Defaults to
AWS_S3_BASE_URL=

# --- Deploy webhook (POST /v1/deploy/github) ---
GITHUB_WEBHOOK_SECRET=

# Only pushes to this branch trigger a rebuild.
DEPLOY_BRANCH=main

# Path to the rebuild script inside the container.
DEPLOY_SCRIPT=/root/scripts/deploy.sh

# Hard limit on a single deploy run.
DEPLOY_TIMEOUT_MINUTES=15

# Repo checkout as seen inside the container, and its path on the EC2 host.
REPO_DIR=/repo
HOST_REPO_DIR=/home/ec2-user/loof-api

# Image and container names the script builds and swaps.
IMAGE_NAME=loof-api
CONTAINER_NAME=loof-api

# Host port published, and the port the server listens on inside the container.
HOST_PORT=8000
APP_PORT=8000

# Read-only PAT, only needed for a private repo. Both must be set together.
GITHUB_TOKEN=
GITHUB_REPOSITORY=
